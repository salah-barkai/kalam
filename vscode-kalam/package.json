{
  "name": "kalam",
  "displayName": "Kalam — programmer en arabe tchadien",
  "description": "Langage de programmation en arabe tchadien (lettres latines) : couleurs, erreurs en rouge, autocomplétion, aide en français et exécution avec F5.",
  "keywords": ["kalam", "tchad", "chad", "arabe", "arabic", "tchadien", "éducation", "langage", "klm"],
  "version": "0.2.0",
  "publisher": "salah-barkai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/salah-barkai/kalam.git",
    "directory": "vscode-kalam"
  },
  "homepage": "https://salah-barkai.github.io/kalam/",
  "bugs": {
    "url": "https://github.com/salah-barkai/kalam/issues"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0A1F44",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "capabilities": {
    "untrustedWorkspaces": { "supported": true }
  },
  "categories": ["Programming Languages", "Snippets", "Education"],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node scripts/copy-kalam.js"
  },
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "kalam",
        "aliases": ["Kalam", "kalam"],
        "extensions": [".klm"],
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kalam",
        "scopeName": "source.kalam",
        "path": "./syntaxes/kalam.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kalam",
        "path": "./snippets/kalam.json"
      }
    ],
    "commands": [
      {
        "command": "kalam.run",
        "title": "Kalam : Shaghghil al-file (Exécuter)",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "kalam.run",
          "when": "resourceLangId == kalam",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kalam.run",
        "key": "f5",
        "when": "editorLangId == kalam"
      }
    ],
    "configuration": {
      "title": "Kalam",
      "properties": {
        "kalam.verifier": {
          "type": "boolean",
          "default": true,
          "description": "Souligner les erreurs en rouge pendant la frappe."
        }
      }
    }
  }
}

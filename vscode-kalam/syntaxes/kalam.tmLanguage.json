{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kalam",
  "scopeName": "source.kalam",
  "fileTypes": ["klm"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#function-def" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#builtin" },
    { "include": "#call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.kalam"
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.kalam",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.kalam" }]
        },
        {
          "begin": "(?<![\\p{L}\\p{N}_])'",
          "end": "'|$",
          "name": "string.quoted.single.kalam",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.kalam" }]
        }
      ]
    },
    "function-def": {
      "match": "\\b(khid[iî]m[eê])\\s+([\\p{L}_][\\p{L}\\p{N}_']*)",
      "captures": {
        "1": { "name": "storage.type.function.kalam" },
        "2": { "name": "entity.name.function.kalam" }
      }
    },
    "keyword": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_'])(k[aâ]n|w[aâ]ll[aâ]|kh[aâ]l[aâ]s|t[uû]lm[aâ]|k[uû]ll[aâ]|f[iî]|m[iî]n|l[aâ]h[aâ]dd[iî]|r[aâ]jj[aâ]|[aâ]g[iî]f|f[uû]t|j[aâ]rr[iî]b|m[uû]shk[iî]l[aâ]|z[aâ]g[iî]l|j[iî]b)(?![\\p{L}\\p{N}_'])",
          "name": "keyword.control.kalam"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_'])(kh[aâ]ll[iî])(?![\\p{L}\\p{N}_'])",
          "name": "storage.type.kalam"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_'])(khid[iî]m[eê])(?![\\p{L}\\p{N}_'])",
          "name": "storage.type.function.kalam"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_'])(w[aâ]|[aâ]w|m[aâ])(?![\\p{L}\\p{N}_'])",
          "name": "keyword.operator.logical.kalam"
        }
      ]
    },
    "constant": {
      "match": "(?<![\\p{L}\\p{N}_'])(s[aâ]h[iî]|gh[aâ]l[aâ]t|m[aâ]f[iî]|PI)(?![\\p{L}\\p{N}_'])",
      "name": "constant.language.kalam"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.kalam"
    },
    "builtin": {
      "match": "(?<![\\p{L}\\p{N}_'.])([oô]r[iî]|[aâ]s[aâ]l|g[aâ]d[uû]r|n[iî]mr[aâ]|k[iî]t[aâ]b[aâ]|sh[aâ]k[aâ]l|z[iî]d|sh[iî]l|m[aâ]f[aâ]t[iî]h|s[uû]df[aâ]|j[iî]d[iî]r|g[aâ]ss[iî]m|l[uû]mm|r[aâ]tt[iî]b|k[aâ]b[iî]r|s[aâ]gh[aâ]yy[aâ]r|[aâ]kt[aâ]r|[aâ]g[aâ]ll|j[uû]ml[aâ]|g[aâ]rr[iî]b|m[uû]tl[aâ]g|f[aâ]tt[iî]sh|gh[aâ]yy[iî]r|g[aâ]t[aâ]|g[aâ]ll[iî]b|n[aâ]dd[iî]f|b[aâ]d[aâ]_be|k[aâ]mm[aâ]l_be|[aâ]z[iî]l|kh[aâ]lb[iî]t|g[iî]y[aâ]m|n[uû]skh[aâ]|w[aâ]k[iî]t|[aâ]g[oô]d|[aâ]l_y[oô]m|[aâ]s_s[aâ]|[aâ]gr[iî]|[aâ]kt[iî]b)(?=\\s*\\()",
      "name": "support.function.builtin.kalam"
    },
    "call": {
      "match": "([\\p{L}_][\\p{L}\\p{N}_']*)(?=\\s*\\()",
      "name": "entity.name.function.call.kalam"
    },
    "operator": {
      "match": "==|!=|<=|>=|[+\\-*/%<>=]",
      "name": "keyword.operator.kalam"
    }
  }
}

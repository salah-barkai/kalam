{
  "kan (if)": {
    "prefix": "kan",
    "body": ["kan ${1:shart}", "\t$0", "khalas"],
    "description": "kan … khalas (si)"
  },
  "kan … walla (if/else)": {
    "prefix": "kanw",
    "body": ["kan ${1:shart}", "\t$2", "walla", "\t$0", "khalas"],
    "description": "kan … walla … khalas (si / sinon)"
  },
  "tulma (while)": {
    "prefix": "tulma",
    "body": ["tulma ${1:shart}", "\t$0", "khalas"],
    "description": "tulma … khalas (tant que)"
  },
  "kulla … fi (for each)": {
    "prefix": "kulla",
    "body": ["kulla ${1:x} fi ${2:liste}", "\t$0", "khalas"],
    "description": "kulla x fi liste (pour chaque)"
  },
  "kulla … min … lahaddi (for range)": {
    "prefix": "kullamin",
    "body": ["kulla ${1:i} fi min ${2:1} lahaddi ${3:10}", "\t$0", "khalas"],
    "description": "kulla i fi min 1 lahaddi 10 (boucle de 1 à 10)"
  },
  "khidma (function)": {
    "prefix": "khidma",
    "body": ["khidma ${1:ism}(${2})", "\t$0", "khalas"],
    "description": "khidma … khalas (fonction)"
  },
  "khalli (let)": {
    "prefix": "khalli",
    "body": ["khalli ${1:ism} = ${0}"],
    "description": "Déclarer une variable"
  },
  "ori (print)": {
    "prefix": "ori",
    "body": ["ori(${0})"],
    "description": "Afficher"
  }
}
